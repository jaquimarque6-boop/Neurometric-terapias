# Local development — copy to .env. On Replit/Render the platform injects
# these (DATABASE_URL or PGHOST/PGDATABASE, PORT), so .env is local-only.

# neurometric-pg Docker container (host port 5433)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/neurometric

# API port. Vite dev server runs on 3000 and proxies /api here
# (see artifacts/neurometric-lab/vite.config.ts).
PORT=3001
